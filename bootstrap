#!/bin/bash
# 阿里云函数计算 FC Custom Runtime 启动入口
# FC 会通过 FC_SERVER_PORT 环境变量指定监听端口（默认9000）

export FC_SERVER_PORT=${FC_SERVER_PORT:-9000}

# 安装依赖（首次冷启动时）
if [ ! -d "/tmp/deps_installed" ]; then
    pip install -r /code/requirements.txt -t /code/python_packages -q 2>/dev/null
    touch /tmp/deps_installed
fi

export PYTHONPATH=/code/python_packages:$PYTHONPATH

# 启动 Flask 应用（生产模式，监听FC指定端口）
exec python -c "
from app import app
import os
port = int(os.environ.get('FC_SERVER_PORT', 9000))
app.run(host='0.0.0.0', port=port, debug=False)
"
